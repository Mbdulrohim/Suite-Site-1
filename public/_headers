# The holding page this replaced shipped no JavaScript, so it could afford
# `default-src 'none'` with no script-src at all. This site is a React bundle
# with GSAP animation and webfonts, and that policy would blank it — every
# rule below exists because something on the page needs it.
#
# 'unsafe-inline' in style-src is GSAP: it animates by writing inline style
# attributes, which CSP counts as inline styles. There is no nonce path for
# that short of rewriting the animations.
#
# The two third-party hosts are each here for one thing, and both would be
# better off gone — see "Known gaps" in the README:
#   images.unsplash.com   the photo texture inside the masked SUITE wordmark
#                         (HugeSuiteWatermark). Blocked, that section renders
#                         as empty space.
#   static.cloudflareinsights.com  the Web Analytics beacon Cloudflare injects
#                         at the edge. Blocked, it errors in the console on
#                         every page load and reports nothing.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://images.unsplash.com; connect-src 'self' https://cloudflareinsights.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), interest-cohort=()

# The HTML is the prerendered page and changes with every copy edit, so it is
# always revalidated.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Vite content-hashes everything under /assets, so a new build gets a new URL
# and these can be cached for as long as the browser will hold them.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/og.png
  Cache-Control: public, max-age=3600
